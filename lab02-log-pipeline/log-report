#!/usr/bin/env bash
set -Eeuo pipefail

PROG=${0##*/}
VERSION="1.0.0"

INPUT=""
TOP=10
FORMAT="text"
STRICT=0

usage() {
  cat <<USAGE
Usage: $PROG --input FILE [OPTIONS]

Options:
  --input FILE       Input log file (or - for stdin) (required)
  --top N            Number of top URLs/IPs to show (default: 10)
  --format text|json Output format (default: text)
  --strict           Fail immediately on first malformed line
  --help             Show this help
  --version          Show version
USAGE
}

die() { echo "ERROR: $*" >&2; exit 1; }

while (($#)); do
  case "$1" in
    --help) usage; exit 0 ;;
    --version) echo "$PROG $VERSION"; exit 0 ;;
    --input) [[ $# -ge 2 ]] || die "--input requires argument"; INPUT=$2; shift 2 ;;
    --input=*) INPUT=${1#*=}; shift ;;
    --top) [[ $# -ge 2 ]] || die "--top requires argument"; TOP=$2; shift 2 ;;
    --top=*) TOP=${1#*=}; shift ;;
    --format) [[ $# -ge 2 ]] || die "--format requires argument"; FORMAT=$2; shift 2 ;;
    --format=*) FORMAT=${1#*=}; shift ;;
    --strict) STRICT=1; shift ;;
    --) shift; break ;;
    -*) die "Unknown option: $1" ;;
    *) die "Unexpected argument: $1" ;;
  esac
done

[[ -n $INPUT ]] || die "--input is required"
[[ $INPUT == "-" || -f $INPUT ]] || die "Input file not found: $INPUT"
[[ $FORMAT == "text" || $FORMAT == "json" ]] || die "Invalid format: $FORMAT"
[[ $TOP =~ ^[0-9]+$ ]] || die "--top must be an integer"

awk -v strict="$STRICT" -v top_n="$TOP" -v format="$FORMAT" '
BEGIN {
  total=0; malformed=0; bytes=0; failed=0;
}

NF == 0 { next }

{
  # Простой парсинг через регулярное выражение
  if (match($0, /^([^ ]+) - - \[([^]]+)\] "([^ ]+) ([^ ]+) [^"]+" ([0-9]+) ([0-9]+) ([0-9]+)$/, arr)) {
    ip = arr[1]
    path = arr[4]
    status = arr[5]
    size = arr[6]
    resp_time = arr[7]

    total++
    bytes += size

    if (status ~ /^2/) stat_2xx++
    else if (status ~ /^3/) stat_3xx++
    else if (status ~ /^4/) { stat_4xx++; ip_errors[ip]++ }
    else if (status ~ /^5/) { stat_5xx++; ip_errors[ip]++ }

    url_count[path]++
    resp_times[total] = resp_time
    
  } else {
    malformed++
    if (strict) {
      print "STRICT MODE ERROR: Malformed line: " $0 > "/dev/stderr"
      failed = 1
      exit 1
    }
  }
}

END {
  if (failed) exit 1

  # Сортировка по убыванию для топов
  PROCINFO["sorted_in"] = "@val_num_desc"

  # Перцентили
  n = asort(resp_times)
  if (n > 0) {
    p50 = resp_times[int(n * 0.50)]
    p95 = resp_times[int(n * 0.95)]
    p99 = resp_times[int(n * 0.99)]
  } else {
    p50 = 0; p95 = 0; p99 = 0
  }

  if (format == "json") {
    printf "{\n"
    printf "  \"total_requests\": %d,\n", total
    printf "  \"malformed_lines\": %d,\n", malformed
    printf "  \"bytes_transferred\": %d,\n", bytes
    printf "  \"status_codes\": {\"2xx\": %d, \"3xx\": %d, \"4xx\": %d, \"5xx\": %d},\n", stat_2xx, stat_3xx, stat_4xx, stat_5xx
    printf "  \"percentiles\": {\"p50\": %d, \"p95\": %d, \"p99\": %d},\n", p50, p95, p99
    
    printf "  \"top_urls\": [\n"
    count = 0
    for (url in url_count) {
        if (count > 0) printf ",\n"
        if (count++ >= top_n) break
        printf "    {\"url\": \"%s\", \"count\": %d}", url, url_count[url]
    }
    printf "\n  ],\n"
    
    printf "  \"top_error_ips\": [\n"
    count = 0
    for (ip in ip_errors) {
        if (count > 0) printf ",\n"
        if (count++ >= top_n) break
        printf "    {\"ip\": \"%s\", \"errors\": %d}", ip, ip_errors[ip]
    }
    printf "\n  ]\n}\n"
  } else {
    print "=== Log Report ==="
    printf "Total Requests:   %d\n", total
    printf "Malformed Lines:  %d\n", malformed
    printf "Bytes Transferred: %d\n", bytes
    printf "Status Codes:     2xx=%d, 3xx=%d, 4xx=%d, 5xx=%d\n", stat_2xx, stat_3xx, stat_4xx, stat_5xx
    printf "Response Times:   p50=%dms, p95=%dms, p99=%dms\n", p50, p95, p99
    
    printf "\nTop %d URLs:\n", top_n
    count = 0
    for (url in url_count) {
        if (count++ >= top_n) break
        printf "  %5d  %s\n", url_count[url], url
    }
    
    printf "\nTop %d Error IPs (4xx/5xx):\n", top_n
    count = 0
    for (ip in ip_errors) {
        if (count++ >= top_n) break
        printf "  %5d  %s\n", ip_errors[ip], ip
    }
  }
}
' "$INPUT"