#!/usr/bin/env bash
set -Eeuo pipefail

PROG=${0##*/}
VERSION="1.0.0"

TIMEOUT=""
RETRIES=0
LOG_DIR=""
CMD_ARGS=()

TIMEOUT_SEC=0
CHILD_PID=""
TIMER_PID=""
STATUS=""
EXIT_CODE=0

usage() {
  cat <<USAGE
Usage: $PROG --timeout 30s --retries 3 --log-dir DIR -- command arg1 arg2

Options:
  --timeout DUR      Timeout (e.g., 10s, 1m) (required)
  --retries N        Number of retry attempts (default: 0)
  --log-dir DIR      Directory to save logs and metadata (required)
  --help             Show this help
  --version          Show version
USAGE
}

die() { echo "ERROR: $*" >&2; exit 1; }

# --- Обработка сигналов ---
cleanup() {
  local ec=$?
  trap - EXIT INT TERM
  
  if [[ -n "$TIMER_PID" ]] && kill -0 "$TIMER_PID" 2>/dev/null; then
    kill -TERM "$TIMER_PID" 2>/dev/null || true
  fi
  
  if [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
    kill -TERM "$CHILD_PID" 2>/dev/null || true
    sleep 1
    if kill -0 "$CHILD_PID" 2>/dev/null; then
      kill -KILL "$CHILD_PID" 2>/dev/null || true
    fi
  fi
  exit "$ec"
}
trap cleanup EXIT INT TERM

# --- Разбор аргументов ---
while (($#)); do
  case "$1" in
    --help) usage; exit 0 ;;
    --version) echo "$PROG $VERSION"; exit 0 ;;
    --timeout) [[ $# -ge 2 ]] || die "--timeout requires argument"; TIMEOUT=$2; shift 2 ;;
    --timeout=*) TIMEOUT=${1#*=}; shift ;;
    --retries) [[ $# -ge 2 ]] || die "--retries requires argument"; RETRIES=$2; shift 2 ;;
    --retries=*) RETRIES=${1#*=}; shift ;;
    --log-dir) [[ $# -ge 2 ]] || die "--log-dir requires argument"; LOG_DIR=$2; shift 2 ;;
    --log-dir=*) LOG_DIR=${1#*=}; shift ;;
    --) shift; CMD_ARGS=("$@"); break ;;
    -*) die "Unknown option: $1" ;;
    *) die "Unexpected argument: $1" ;;
  esac
done

[[ -n $TIMEOUT ]] || die "--timeout is required"
[[ -n $LOG_DIR ]] || die "--log-dir is required"
[[ ${#CMD_ARGS[@]} -gt 0 ]] || die "No command specified"

# Парсим таймаут
if [[ $TIMEOUT =~ ^([0-9]+)s$ ]]; then
  TIMEOUT_SEC=${BASH_REMATCH[1]}
elif [[ $TIMEOUT =~ ^([0-9]+)m$ ]]; then
  TIMEOUT_SEC=$(( BASH_REMATCH[1] * 60 ))
elif [[ $TIMEOUT =~ ^([0-9]+)$ ]]; then
  TIMEOUT_SEC=$TIMEOUT
else
  die "Invalid timeout format. Use e.g. 30s or 1m"
fi

mkdir -p "$LOG_DIR"

# --- Основная функция ---
run_attempt() {
  local attempt=$1
  local out_log="$LOG_DIR/attempt_${attempt}_stdout.log"
  local err_log="$LOG_DIR/attempt_${attempt}_stderr.log"
  local meta_log="$LOG_DIR/attempt_${attempt}_meta.json"

  STATUS="failed"
  EXIT_CODE=1
  local start_time=$(date +%s)

  # Запускаем команду в фоне
  "${CMD_ARGS[@]}" > "$out_log" 2> "$err_log" &
  CHILD_PID=$!

  # Запускаем таймер в фоне
  (
    sleep "$TIMEOUT_SEC"
    if kill -0 "$CHILD_PID" 2>/dev/null; then
      echo "TIMEOUT: Sent SIGTERM" >> "$err_log"
      kill -TERM "$CHILD_PID" 2>/dev/null
      sleep 1
      if kill -0 "$CHILD_PID" 2>/dev/null; then
        echo "TIMEOUT: Sent SIGKILL" >> "$err_log"
        kill -KILL "$CHILD_PID" 2>/dev/null
      fi
    fi
  ) &
  TIMER_PID=$!

  # Ждем завершения дочернего процесса
  set +e
  wait "$CHILD_PID" 2>/dev/null
  EXIT_CODE=$?
  set -e

  # Останавливаем таймер, если он еще тикает
  if kill -0 "$TIMER_PID" 2>/dev/null; then
    kill -TERM "$TIMER_PID" 2>/dev/null || true
    wait "$TIMER_PID" 2>/dev/null || true
  fi
  TIMER_PID=""

  # Разбираем код возврата
  if [[ $EXIT_CODE -eq 0 ]]; then
    STATUS="success"
  elif [[ $EXIT_CODE -eq 143 || $EXIT_CODE -eq 137 ]]; then
    STATUS="timeout"
  else
    STATUS="failed"
  fi

  local elapsed=$(( $(date +%s) - start_time ))

  # Записываем метаданные
  cat > "$meta_log" <<META
{
  "attempt": $attempt,
  "command": "${CMD_ARGS[*]}",
  "exit_code": $EXIT_CODE,
  "status": "$STATUS",
  "elapsed_sec": $elapsed
}
META

  CHILD_PID=""
  return $EXIT_CODE
}

# --- Цикл ретраев ---
for (( i=0; i<=RETRIES; i++ )); do
  if run_attempt "$i"; then
    exit 0
  fi
  if (( i < RETRIES )); then
    backoff=$(( 2 ** i ))
    echo "Attempt $i failed. Retrying in ${backoff}s..." >&2
    sleep "$backoff"
  fi
done

echo "All attempts failed." >&2
exit 1