#!/usr/bin/env bash
set -Eeuo pipefail

PROG=${0##*/}
VERSION="1.0.0"

OUTPUT=""
WINDOW="5m"
SERVICE=""
LOG_FILE=""
MAX_PARALLEL=4
REDACT_CONF=""
DRY_RUN=0

ACTIVE_PIDS=()
EXIT_STATUS=0
ERRORS=()

usage() {
  cat <<USAGE
Usage: $PROG --output DIR [OPTIONS]

Options:
  --output DIR           Directory to save report (required)
  --window DUR           Time window (e.g. 5m, 1h) (default: 5m)
  --service URL          HTTP service to probe
  --log FILE             Log file to collect recent lines
  --max-parallel N       Max parallel collectors (default: 4)
  --redact-config FILE   File with secrets patterns to redact
  --dry-run              Show plan without execution
  --help                 Show help
  --version              Show version
USAGE
}

die() { echo "ERROR: $*" >&2; exit 2; }

cleanup() {
  local ec=$?
  trap - EXIT INT TERM
  local active_pids
  active_pids=$(jobs -pr || true)
  if [[ -n "$active_pids" ]]; then
    echo "Stopping active collectors..." >&2
    for pid in $active_pids; do
      kill -TERM "$pid" 2>/dev/null || true
    done
  fi
  exit "$ec"
}
trap cleanup EXIT INT TERM

while (($#)); do
  case "$1" in
    --help) usage; exit 0 ;;
    --version) echo "$PROG $VERSION"; exit 0 ;;
    --output) [[ $# -ge 2 ]] || die "--output requires arg"; OUTPUT=$2; shift 2 ;;
    --output=*) OUTPUT=${1#*=}; shift ;;
    --window) [[ $# -ge 2 ]] || die "--window requires arg"; WINDOW=$2; shift 2 ;;
    --window=*) WINDOW=${1#*=}; shift ;;
    --service) [[ $# -ge 2 ]] || die "--service requires arg"; SERVICE=$2; shift 2 ;;
    --service=*) SERVICE=${1#*=}; shift ;;
    --log) [[ $# -ge 2 ]] || die "--log requires arg"; LOG_FILE=$2; shift 2 ;;
    --log=*) LOG_FILE=${1#*=}; shift ;;
    --max-parallel) [[ $# -ge 2 ]] || die "--max-parallel requires arg"; MAX_PARALLEL=$2; shift 2 ;;
    --max-parallel=*) MAX_PARALLEL=${1#*=}; shift ;;
    --redact-config) [[ $# -ge 2 ]] || die "--redact-config requires arg"; REDACT_CONF=$2; shift 2 ;;
    --redact-config=*) REDACT_CONF=${1#*=}; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) die "Unknown option: $1" ;;
  esac
done

[[ -n "$OUTPUT" ]] || die "--output is required"

if [[ -f "$OUTPUT/report.md" ]] || [[ -f "$OUTPUT/report.json" ]]; then
  die "Output directory already contains a report. Refusing to overwrite."
fi

if (( DRY_RUN == 1 )); then
  echo "DRY-RUN: Would create output directory: $OUTPUT"
  echo "DRY-RUN: Would collect OS, memory, disk, inodes, processes"
  [[ -n "$SERVICE" ]] && echo "DRY-RUN: Would probe service: $SERVICE"
  [[ -n "$LOG_FILE" ]] && echo "DRY-RUN: Would collect logs from: $LOG_FILE"
  echo "DRY-RUN: Would generate report.md and report.json"
  exit 0
fi

mkdir -p "$OUTPUT/raw"

redact_file() {
  local file=$1
  if [[ -n "$REDACT_CONF" && -f "$REDACT_CONF" ]]; then
    while IFS= read -r pattern; do
      [[ -z "$pattern" || "$pattern" =~ ^# || "$pattern" =~ ^\[ ]] && continue
      sed -i "s/\(${pattern}[=: ]*\).*/\1***/gi" "$file" 2>/dev/null || true
    done < <(tr -d '\r' < "$REDACT_CONF")
  fi
}

run_collector() {
  local name=$1
  local cmd=$2
  local out_file="$OUTPUT/raw/${name}.txt"

  # Оборачиваем eval в подшелл, чтобы exit 1 не убивал саму функцию
  if (eval "timeout 10s $cmd") > "$out_file" 2>&1; then
    redact_file "$out_file"
    return 0
  else
    echo "TIMEOUT or ERROR during $name" >> "$out_file"
    return 1
  fi
}

echo "Starting collection (max parallel: $MAX_PARALLEL)..."
START_TIME=$(date +%s)

COLLECTORS=(
  "os:uname -a; cat /etc/os-release 2>/dev/null || true"
  "mem:free -m 2>/dev/null || vmstat 2>/dev/null || echo 'Mem info not available'"
  "disk:df -h"
  "inodes:df -i"
  "proc:ps aux | head -n 20"
)

if [[ -n "$SERVICE" ]]; then
  COLLECTORS+=("http:curl -sS -o /dev/null -w '%{http_code}|%{time_total}' --connect-timeout 5 --max-time 10 '$SERVICE'")
fi

if [[ -n "$LOG_FILE" ]]; then
  if [[ -f "$LOG_FILE" ]]; then
    COLLECTORS+=("logs:tail -n 50 '$LOG_FILE'")
  else
    COLLECTORS+=("logs:echo 'ERROR: Log file not found: $LOG_FILE'; exit 1")
  fi
fi

for item in "${COLLECTORS[@]}"; do
  name="${item%%:*}"
  cmd="${item#*:}"

  while (( ${#ACTIVE_PIDS[@]} >= MAX_PARALLEL )); do
    set +e
    wait -n
    set -e
    NEW_PIDS=()
    for pid in "${ACTIVE_PIDS[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        NEW_PIDS+=("$pid")
      fi
    done
    ACTIVE_PIDS=("${NEW_PIDS[@]}")
  done

  run_collector "$name" "$cmd" &
  ACTIVE_PIDS+=($!)
done

set +e
for pid in "${ACTIVE_PIDS[@]}"; do
  wait "$pid" 2>/dev/null || true
done
set -e

# Проверяем логи сборщиков на наличие ошибок
for file in "$OUTPUT/raw"/*.txt; do
  [[ -e "$file" ]] || continue
  if grep -q "TIMEOUT or ERROR" "$file"; then
    name=$(basename "$file" .txt)
    ERRORS+=("$name failed")
    EXIT_STATUS=1
  fi
done

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
REPORT_MD="$OUTPUT/report.md"

{
  echo "# Incident Collection Report"
  echo "Generated at: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  echo "Duration: ${DURATION}s"
  echo ""
  
  if [[ ${#ERRORS[@]} -gt 0 ]]; then
    echo "## ⚠️ Warnings"
    for err in "${ERRORS[@]}"; do echo "- $err"; done
    echo ""
  fi

  for file in "$OUTPUT/raw"/*.txt; do
    [[ -e "$file" ]] || continue
    title=$(basename "$file" .txt | tr '[:lower:]' '[:upper:]')
    echo "## $title"
    echo '```'
    cat "$file"
    echo '```'
    echo ""
  done
} > "$REPORT_MD"

REPORT_JSON="$OUTPUT/report.json"
{
  echo "{"
  echo "  \"generated_at\": \"$(date -u +"%Y-%m-%dT%H:%M:%SZ")\","
  echo "  \"duration_sec\": $DURATION,"
  echo "  \"errors\": ${#ERRORS[@]},"
  echo "  \"sections\": ["
  first=1
  for file in "$OUTPUT/raw"/*.txt; do
    [[ -e "$file" ]] || continue
    name=$(basename "$file" .txt)
    if [[ $first -eq 0 ]]; then echo ","; fi
    first=0
    echo -n "    {\"name\": \"$name\", \"file\": \"raw/$(basename "$file")\"}"
  done
  echo ""
  echo "  ]"
  echo "}"
} > "$REPORT_JSON"

(cd "$OUTPUT" && sha256sum raw/*.txt report.md report.json > checksums.sha256)

echo "Collection complete. Report saved to $OUTPUT/report.md"
if [[ $EXIT_STATUS -ne 0 ]]; then
  echo "Partial success (some collectors failed). Exit code: 1"
  exit 1
fi
exit 0